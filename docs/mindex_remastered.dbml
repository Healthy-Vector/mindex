// Mindex remastered schema — PostgreSQL 16
// SQL counterpart: sql/init/*.sql (2026-08-20, D-30)
// Flow: PDF/OCR/AI extraction -> validate_rights_batch()
//       -> user confirmation -> save_rights_batch() -> all-or-nothing

Project mindex {
  database_type: 'PostgreSQL'
  Note: '''
  contract는 계약 업무 건, contract_history는 PDF 한 건과 판정 결과다.
  candidate/evaluation 계층 없이 계약서 권리 배치를 원자적으로 등록한다.
  판정축은 legal_right × exploitation_mode 두 계층을 유지한다(D-27).
  evidence JSONB는 각 필드의 페이지·조항·원문 인용을 보존한다.
  team은 PIN 관리용 독립 개념이며 tenant가 아니다.
  '''
}

Enum result_kind {
  NORMAL
  CONFLICT
  REVIEW_REQUIRED
  WARNING
}

Enum exclusivity_kind {
  exclusive
  sole
  non_exclusive
}

Enum contract_status {
  draft
  active
  final
  rejected
  terminated
}

Enum contract_history_status {
  registered
  conflicted
}

Enum rights_grant_status {
  active
  terminated
}

Enum terminated_reason_kind {
  superseded
  expired
  waiver
  cancelled
}

Enum asset_scope_kind {
  SERIES_ALL
  SEASON
  EPISODE
  EDITION
}

Table country {
  code CHAR(2) [pk]
  in_scope BOOLEAN [not null, default: false]
}
Table country_label {
  country_code CHAR(2) [pk]
  lang CHAR(2) [pk]
  label TEXT [not null]
}
Table territory_group {
  code TEXT [pk]
  note TEXT
}
Table territory_group_label {
  group_code TEXT [pk]
  lang CHAR(2) [pk]
  label TEXT [not null]
}
Table territory_group_member {
  group_code TEXT [pk]
  country_code CHAR(2) [pk]
}
Table legal_right {
  code TEXT [pk]
  parent_code TEXT
  name_ko TEXT [not null]
  lft INT [not null]
  rgt INT [not null]
  span INT4RANGE [note: 'GENERATED ALWAYS AS int4range(lft, rgt+1) STORED']
  note TEXT
}
Table exploitation_mode {
  code TEXT [pk]
  parent_code TEXT
  name_ko TEXT [not null]
  lft INT [not null]
  rgt INT [not null]
  span INT4RANGE [note: 'GENERATED ALWAYS AS int4range(lft, rgt+1) STORED']
  note TEXT
}
Table reason_code {
  code TEXT [pk]
  category TEXT [not null]
  result_type result_kind [not null]
  rule_code TEXT
  severity SMALLINT [not null, default: 50]
  is_decision_reason BOOLEAN [not null]
  name_ko TEXT [not null]
  template_ko TEXT [not null]
  template_en TEXT [not null]
  implemented BOOLEAN [not null, default: false]
  active BOOLEAN [not null, default: true]
}
Table constraint_reason_map {
  constraint_name TEXT [pk]
  reason_code TEXT [not null]
}
Table ip {
  id BIGSERIAL [pk]
  title TEXT [not null]
  kind TEXT
  created_at TIMESTAMPTZ [not null, default: `now()`]
}
Table ip_alias {
  id BIGSERIAL [pk]
  ip_id BIGINT [not null]
  alias_text TEXT [not null]
  lang CHAR(2)
  alias_type TEXT [not null, default: 'title']
  created_at TIMESTAMPTZ [not null, default: `now()`]
  Indexes { (ip_id, alias_text, lang) [unique] }
}
Table content_asset {
  id BIGSERIAL [pk]
  ip_id BIGINT [not null]
  parent_id BIGINT
  asset_type TEXT [not null, default: 'MAIN']
  scope_type asset_scope_kind [not null, default: 'SERIES_ALL']
  season_no INT
  episode_no INT
  edition_code TEXT
  title TEXT
  created_at TIMESTAMPTZ [not null, default: `now()`]
}
Table team {
  id BIGSERIAL [pk]
  name TEXT [not null]
  pin_hash TEXT [not null]
  created_at TIMESTAMPTZ [not null, default: `now()`]
  Note: 'PIN 관리용 독립 테이블. tenant/RLS 경계가 아니며 team_id를 다른 테이블에 전파하지 않는다.'
}
Table contract {
  id BIGSERIAL [pk]
  counterparty TEXT [not null]
  signed_date DATE
  lang CHAR(2)
  amount NUMERIC
  currency CHAR(4)
  status contract_status [not null, default: 'draft']
  current_history_id BIGINT
  created_at TIMESTAMPTZ [not null, default: `now()`]
  updated_at TIMESTAMPTZ [not null, default: `now()`]
}
Table contract_history {
  id BIGSERIAL [pk]
  contract_id BIGINT [not null]
  version INT [not null]
  status contract_history_status [not null]
  file_name TEXT [not null]
  file_path TEXT [not null]
  file_hash TEXT [not null]
  mime_type TEXT [not null, default: 'application/pdf']
  raw_text TEXT
  conflict_report JSONB
  uploaded_at TIMESTAMPTZ [not null, default: `now()`]
  Indexes { (contract_id, version) [unique] }
  Note: 'PDF 세대. registered면 배치 전체가 grant로 등록되고 conflicted면 grant 0행과 conflict_report가 남는다.'
}
Table rights_grant {
  id BIGSERIAL [pk]
  contract_id BIGINT [not null]
  contract_history_id BIGINT [not null]
  content_asset_id BIGINT [not null]
  lineage_id BIGINT [not null, note: 'FK가 아닌 논리 계보 값']
  status rights_grant_status [not null, default: 'active']
  territory CHAR(2) [not null]
  legal_right TEXT [not null]
  exploitation_mode TEXT [not null]
  legal_right_span INT4RANGE [not null]
  exploitation_mode_span INT4RANGE [not null]
  period DATERANGE [not null]
  exclusivity exclusivity_kind [not null]
  evidence JSONB [not null]
  conditions_raw JSONB
  terminated_at TIMESTAMPTZ
  terminated_reason terminated_reason_kind
  termination_note TEXT
  created_at TIMESTAMPTZ [not null, default: `now()`]
  Note: 'active 권리는 content_asset × territory × 두 taxonomy span × period로 충돌 판정한다. 다른 contract끼리만 비교한다.'
}
Table contract_chunk {
  id BIGSERIAL [pk]
  contract_id BIGINT [not null]
  contract_history_id BIGINT [not null]
  clause_no TEXT
  chunk_text TEXT [not null]
  lang CHAR(2)
  page INT
  embedding VECTOR(1024)
  created_at TIMESTAMPTZ [not null, default: `now()`]
}
Table change_log {
  id BIGSERIAL [pk]
  table_name TEXT [not null]
  row_id BIGINT [not null]
  op CHAR(1) [not null]
  processed_at TIMESTAMPTZ
  attempts INT [not null, default: 0]
  last_error TEXT
  created_at TIMESTAMPTZ [not null, default: `now()`]
}
Table schema_meta {
  version TEXT [pk]
  description TEXT
  applied_at TIMESTAMPTZ [not null, default: `now()`]
}

Ref: country_label.country_code > country.code
Ref: territory_group_label.group_code > territory_group.code
Ref: territory_group_member.group_code > territory_group.code
Ref: territory_group_member.country_code > country.code
Ref: legal_right.parent_code > legal_right.code
Ref: exploitation_mode.parent_code > exploitation_mode.code
Ref: constraint_reason_map.reason_code > reason_code.code
Ref: ip_alias.ip_id > ip.id
Ref: content_asset.ip_id > ip.id
Ref: content_asset.parent_id > content_asset.id
Ref: contract.current_history_id > contract_history.id
Ref: contract_history.contract_id > contract.id
Ref: rights_grant.contract_id > contract.id
Ref: rights_grant.contract_history_id > contract_history.id
Ref: rights_grant.content_asset_id > content_asset.id
Ref: rights_grant.territory > country.code
Ref: rights_grant.legal_right > legal_right.code
Ref: rights_grant.exploitation_mode > exploitation_mode.code
Ref: contract_chunk.contract_id > contract.id
Ref: contract_chunk.contract_history_id > contract_history.id
