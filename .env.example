# 이 파일을 .env 로 복사해서 실제 값을 채우세요. .env는 절대 커밋하지 않습니다.

# --- Database ---
DB_USER=mindex
DB_PASSWORD=change_me
DB_NAME=mindex
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- LLM Provider (RFP 8.3-2 결정 대기) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SOLAR_API_KEY=
HYPERCLOVA_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
