# 이 파일을 .env 로 복사해서 실제 값을 채우세요. .env는 절대 커밋하지 않습니다.

# --- Database ---
DB_USER=mindex
DB_PASSWORD=change_me
DB_NAME=mindex
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# staging 스키마(pdf_blob/extract_job/extract_result)도 같은 DB 안에 있어
# 별도 접속 정보가 없다 — 위 DATABASE_URL로 staging.* 테이블까지 접근한다 (D-33)

# --- LLM Provider (RFP 8.3-2 결정 대기) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SOLAR_API_KEY=
HYPERCLOVA_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
